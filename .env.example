# ---- mode: mock (default, runs offline) or live ----
TRUESIGNAL_MODE=mock

# ---- Checkmarx One (live mode) ----
CX_BASE_URL=https://ast.checkmarx.net
CX_TENANT=your-tenant
CX_API_KEY=your-api-refresh-token

# ---- LLM: mock | anthropic | openai | ollama ----
TRUESIGNAL_LLM=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- optional tuning ----
TRUESIGNAL_MIN_CONF=0.85
TRUESIGNAL_MIN_TRIAGE=3
# TRUESIGNAL_REPO=/path/to/customer/repo

# ---- web UI login: two demo accounts, both default password "checkmarx" ----
# TRUESIGNAL_ADMIN_USER=admin
# TRUESIGNAL_ADMIN_PASSWORD=checkmarx
# TRUESIGNAL_APPSEC_USER=appsec
# TRUESIGNAL_APPSEC_PASSWORD=checkmarx
